// Un lot d'achat pour un produit de pharmacie. Chaque achat garde son propre
// prix (traçabilité par lot) : remainingQuantity est décrémenté en FEFO par
// les ventes et les ajustements d'inventaire, ce qui permet de valoriser le
// stock restant aux prix réellement payés plutôt qu'à un prix moyen unique.
model StockPurchase {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyItemId String       @db.ObjectId
  pharmacyItem   PharmacyItem @relation(fields: [pharmacyItemId], references: [id])

  quantity          Int
  remainingQuantity Int
  purchasePrice     Float // Prix d'achat unitaire de ce lot précis (FCFA)
  totalCost         Float

  supplier    String?
  batchNumber String?
  expiryDate  DateTime?
  invoiceRef  String?

  purchasedById  String        @db.ObjectId
  purchasedBy    User          @relation(fields: [purchasedById], references: [id])
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([pharmacyItemId, createdAt])
  @@index([organizationId])
}

