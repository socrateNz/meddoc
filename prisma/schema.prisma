generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  MEDECIN
  CAREGIVER
  PHARMACIST
  FAMILY
  PATIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OrgType {
  HOLDING
  CLINIC
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  TRIALING
}

enum PaymentFrequency {
  MONTHLY
  YEARLY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  PHARMACY_SALE
  SERVICE_FEE
  OPERATIONAL_EXPENSE
  PHARMACY_PURCHASE
  STOCK_ADJUSTMENT
  OTHER
}

enum PharmacyCategory {
  MEDICATION
  CONSUMABLE
  EQUIPMENT
}

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      OrgType
  parentId  String?  @db.ObjectId
  parent    Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Organization[] @relation("OrgHierarchy")
  
  users     User[]
  patients  Patient[]
  wards     Ward[]
  pharmacyItems PharmacyItem[]
  financialTransactions FinancialTransaction[]
  stockPurchases StockPurchase[]
  inventoryCounts InventoryCount[]
  pendingInvoices PendingInvoice[]
  labOrders       LabOrder[]
  labTests        LabTest[]
  prescriptions         Prescription[]
  prescriptionTemplates PrescriptionTemplate[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]

  plan                SubscriptionPlan @default(TRIAL)
  subscriptionStatus  SubscriptionStatus @default(TRIALING)
  licenseExpiresAt    DateTime?
  stripeCustomerId    String?
  maxClinics          Int @default(1)
  maxUsers            Int @default(10)
  isActive            Boolean @default(true)   // Permet à un ADMIN (holding) de suspendre une clinique

  paymentAmount       Float?              // Tarif actuel (FCFA), éditable à tout moment
  paymentFrequency    PaymentFrequency?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  phone         String?
  avatarUrl     String?
  isActive               Boolean   @default(true)
  requiresPasswordChange Boolean   @default(false)
  // Types de Notification (ex: "INCIDENT", "APPOINTMENT") que l'utilisateur a
  // désactivés depuis Paramètres > Notifications. Vide = tout est affiché.
  mutedNotificationTypes String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patientProfile      Patient?            @relation("UserPatient")
  familyProfile       FamilyMember?       @relation("UserFamily")
  caregiverProfile    Caregiver?          @relation("UserCaregiver")
  coordinatorProfile  MedicalCoordinator? @relation("UserCoordinator")

  auditLogs           AuditLog[]
  messagesSent        Message[]           @relation("Sender")
  conversations       ConversationParticipant[]
  notifications       Notification[]
  aiConversations     AIConversation[]
  vitalsRecorded      VitalSign[]         @relation("RecordedVitals")
  financialTransactions FinancialTransaction[] @relation("RecordedTransactions")
  passwordResetTokens PasswordResetToken[]
  stockPurchasesRecorded StockPurchase[]
  inventoryCountsStarted InventoryCount[]
  pendingInvoicesCreated PendingInvoice[] @relation("PendingInvoiceCreatedBy")
  labOrdersOrdered      LabOrder[] @relation("LabOrderOrderedBy")
  labOrdersSampleCollected LabOrder[] @relation("LabOrderSampleCollectedBy")
  labResultsRecorded    LabResult[] @relation("LabResultRecordedBy")
  labResultsValidated   LabResult[] @relation("LabResultValidatedBy")
  medicalRecordsCreated MedicalRecord[] @relation("MedicalRecordCreatedBy")
  prescriptionsWritten         Prescription[]         @relation("PrescriptionPrescribedBy")
  prescriptionTemplatesCreated PrescriptionTemplate[]  @relation("PrescriptionTemplateCreatedBy")
  purchaseOrdersCreated        PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")

  organizationId      String?   @db.ObjectId
  organization        Organization? @relation(fields: [organizationId], references: [id])
}

model Patient {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserPatient", fields: [userId], references: [id])
  
  dateOfBirth     DateTime
  address         String
  emergencyContact String?
  dependencyLevel Int      @default(1)
  bloodType       String?  // ex: "O+", "AB-"
  sex             String?  // ex: "M", "F", "Autre"

  status          String   @default("ADMITTED") // ADMITTED, DISCHARGED, ARCHIVED

  pathologies     String[]
  allergies       String[]

  familyMembers   FamilyMember[]
  carePlans       CarePlan[]
  appointments    Appointment[]
  incidents       Incident[]
  medicalRecords  MedicalRecord[]
  aiAnalyses      AIAnalysis[]
  contracts       Contract[]
  aiConversations AIConversation[]
  vitalSigns      VitalSign[]
  financialTransactions FinancialTransaction[]
  pendingInvoices PendingInvoice[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]

  organizationId  String?   @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])

  wardId          String?   @db.ObjectId
  ward            Ward?     @relation("PatientWard", fields: [wardId], references: [id])
}

model FamilyMember {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserFamily", fields: [userId], references: [id])
  
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  relationship    String
}

model Caregiver {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserCaregiver", fields: [userId], references: [id])
  
  specialties     String[]
  certifications  String[]
  isAvailable     Boolean  @default(true)
  licenseNumber   String?  // N° RPPS/Ordre — renseigné pour un MEDECIN, null pour un infirmier(e)

  tasks           CareTask[]
  appointments    Appointment[]
  contracts       Contract[]
}

model MedicalCoordinator {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserCoordinator", fields: [userId], references: [id])
  
  managedPlans    CarePlan[]
}

model MedicalRecord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])

  title           String
  description     String
  documentUrl     String?
  diagnosisCode   String?  // Code ICD-10 (liste curatée, cf. src/lib/icd10-codes.ts)
  diagnosisLabel  String?
  createdById     String?  @db.ObjectId  // Optionnel : pas de backfill des dossiers historiques
  createdBy       User?    @relation("MedicalRecordCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  pendingInvoices PendingInvoice[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
}

model CarePlan {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String   @db.ObjectId
  patient          Patient  @relation(fields: [patientId], references: [id])
  coordinatorId    String   @db.ObjectId
  coordinator      MedicalCoordinator @relation(fields: [coordinatorId], references: [id])
  
  title            String
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  dischargeSummary String?
  completedAt      DateTime?
  closedById       String?  @db.ObjectId
  
  tasks            CareTask[]
  medications      Medication[]
}

model CareTask {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId      String   @db.ObjectId
  carePlan        CarePlan @relation(fields: [carePlanId], references: [id])
  caregiverId     String?  @db.ObjectId
  caregiver       Caregiver? @relation(fields: [caregiverId], references: [id])
  
  title           String
  description     String?
  scheduledFor    DateTime
  status          String   @default("PENDING")
  completedAt     DateTime?
}

model Medication {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId      String   @db.ObjectId
  carePlan        CarePlan @relation(fields: [carePlanId], references: [id])
  
  name            String
  dosage          String
  frequency       String
  instructions    String?
}

model Appointment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  caregiverId     String?  @db.ObjectId
  caregiver       Caregiver? @relation(fields: [caregiverId], references: [id])

  title           String
  scheduledAt     DateTime
  durationMinutes Int
  type            String
  status          String   @default("SCHEDULED")

  prescriptions   Prescription[]
}

// Demande d'analyse de laboratoire — pas de catalogue structuré (les analyses demandées
// sont une liste de libellés en texte libre), pour éviter d'avoir à gérer un référentiel
// de tests en plus de ce périmètre.
model LabOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])

  medicalRecordId String?  @db.ObjectId
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  organizationId  String?  @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])

  tests           String[] // Libellés des analyses demandées (ex: "NFS", "Glycémie à jeun") — catalogué ou libre
  notes           String?  // Indications cliniques / contexte transmis au laboratoire
  // Cycle de vie complet : PRESCRIBED, SAMPLE_COLLECTED, RECEIVED_AT_LAB, IN_ANALYSIS,
  // TO_VALIDATE, VALIDATED, DELIVERED, CANCELLED (cf. src/actions/lab.ts pour les transitions).
  status          String   @default("PRESCRIBED")
  priority        String   @default("ROUTINE")  // ROUTINE, URGENT

  orderedById     String   @db.ObjectId
  orderedBy       User     @relation("LabOrderOrderedBy", fields: [orderedById], references: [id])

  // Prélèvement
  sampleType          String?   // BLOOD, URINE, STOOL, SALIVA, BIOPSY, CSF, OTHER
  sampleCollectedAt   DateTime?
  sampleCollectedById String?   @db.ObjectId
  sampleCollectedBy   User?     @relation("LabOrderSampleCollectedBy", fields: [sampleCollectedById], references: [id])
  sampleQuantity      String?
  sampleCondition     String?

  results         LabResult[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LabResult {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  labOrderId      String   @db.ObjectId
  labOrder        LabOrder @relation(fields: [labOrderId], references: [id])

  testName        String
  value           String
  unit            String?
  referenceRange  String?
  isAbnormal      Boolean  @default(false)
  notes           String?

  recordedById    String   @db.ObjectId
  recordedBy      User     @relation("LabResultRecordedBy", fields: [recordedById], references: [id])

  // Validation biologique (maker-checker) : une fois posé, le résultat est verrouillé —
  // src/actions/lab.ts refuse toute modification directe, pas seulement l'UI.
  validatedById   String?   @db.ObjectId
  validatedBy     User?     @relation("LabResultValidatedBy", fields: [validatedById], references: [id])
  validatedAt     DateTime?

  createdAt       DateTime @default(now())
}

// Catalogue d'examens définis par le COORDINATOR (prix, durée, service). Les LabOrder.tests
// restent en texte libre — une correspondance par nom avec un LabTest actif permet de
// facturer automatiquement et de détecter les valeurs critiques (cf. Phases B et E).
model LabTest {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  department      String?  // ex: "Hématologie", "Biochimie"
  price           Float?   // FCFA
  durationMinutes Int?
  criticalLow     Float?   // Seuil bas critique (examens à résultat numérique uniquement)
  criticalHigh    Float?   // Seuil haut critique
  consumables     Json?    // Recette de consommables : [{ pharmacyItemId, name, quantity }]

  organizationId  String?  @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Incident {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  reportedById    String   @db.ObjectId
  
  title           String
  description     String
  priority        Priority @default(MEDIUM)
  status          IncidentStatus @default(OPEN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Message {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @db.ObjectId
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderId        String   @db.ObjectId
  sender          User     @relation("Sender", fields: [senderId], references: [id])
  
  content         String
  attachmentUrl   String?
  createdAt       DateTime @default(now())
}

model Conversation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  createdAt       DateTime @default(now())
  
  participants    ConversationParticipant[]
  messages        Message[]
}

model ConversationParticipant {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @db.ObjectId
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
}

model AIAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  
  riskScore       Int
  riskFactors     String[]
  summary         String
  recommendations String[]
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  action          String
  entityType      String
  entityId        String
  details         String?
  createdAt       DateTime @default(now())
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  roles       Role[]
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO")
  createdAt   DateTime @default(now())
}

model Contract {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String   @db.ObjectId
  patient     Patient  @relation(fields: [patientId], references: [id])
  caregiverId String?  @db.ObjectId
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id])
  
  title       String
  status      String   @default("ACTIVE")
  startDate   DateTime
  endDate     DateTime?
  hourlyRate  Float
  hoursPerWeek Int
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIConversation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  patientId   String?  @db.ObjectId
  patient     Patient? @relation(fields: [patientId], references: [id])
  
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    AIMessage[]
}

model AIMessage {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           String
  content        String
  createdAt      DateTime @default(now())
}

model Ward {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String       // Nom d'affichage: "Urgences", "Soins Intensifs", etc.
  code           String       // Code unique: "EMERGENCY", "ICU", "SURGERY"
  capacity       Int          // Capacité maximale en lits
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients       Patient[]    @relation("PatientWard")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model VitalSign {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String   @db.ObjectId
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedById     String   @db.ObjectId
  recordedBy       User     @relation("RecordedVitals", fields: [recordedById], references: [id])
  
  temperature      Float?   // Degrés Celsius (ex: 37.5)
  bloodPressure    String?  // Systolique/Diastolique (ex: "120/80")
  heartRate        Int?     // BPM (ex: 72)
  oxygenSaturation Int?     // SpO2 % (ex: 98)
  bloodSugar       Float?   // g/L (ex: 1.05)
  weight           Float?   // kg (ex: 70.5)
  painScore        Int?     // Échelle 0-10
  notes            String?
  createdAt        DateTime @default(now())
}

model PharmacyItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  dosage         String?  // ex: "500mg, Comprimé"
  category       PharmacyCategory @default(MEDICATION)
  stockQuantity  Int      @default(0)
  reorderLevel   Int      @default(10)
  unitPrice      Float    // Prix unitaire en FCFA
  batchNumber    String?  // Numéro de lot
  expiryDate     DateTime? // Date de péremption
  supplier       String?  // Fournisseur
  location       String?  // Rayon / Emplacement
  organizationId String?  @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  transactions   FinancialTransaction[]
  stockPurchases StockPurchase[]
  stockAdjustments StockAdjustment[]
  inventoryLines InventoryCountLine[]
  prescriptionItems PrescriptionItem[]
  purchaseOrderLines PurchaseOrderLine[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Un lot d'achat pour un produit de pharmacie. Chaque achat garde son propre
// prix (traçabilité par lot) : remainingQuantity est décrémenté en FEFO par
// les ventes et les ajustements d'inventaire, ce qui permet de valoriser le
// stock restant aux prix réellement payés plutôt qu'à un prix moyen unique.
model StockPurchase {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyItemId    String   @db.ObjectId
  pharmacyItem      PharmacyItem @relation(fields: [pharmacyItemId], references: [id])

  quantity          Int
  remainingQuantity Int
  purchasePrice     Float    // Prix d'achat unitaire de ce lot précis (FCFA)
  totalCost         Float

  supplier          String?
  batchNumber       String?
  expiryDate        DateTime?
  invoiceRef        String?

  purchasedById     String   @db.ObjectId
  purchasedBy       User     @relation(fields: [purchasedById], references: [id])
  organizationId    String?  @db.ObjectId
  organization      Organization? @relation(fields: [organizationId], references: [id])

  createdAt         DateTime @default(now())
}

// Correction de stock issue d'un inventaire (ou d'un ajustement manuel).
// quantityDelta négatif = perte, positif = surplus retrouvé.
model StockAdjustment {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyItemId       String   @db.ObjectId
  pharmacyItem         PharmacyItem @relation(fields: [pharmacyItemId], references: [id])
  inventoryCountLineId String?  @db.ObjectId

  quantityDelta        Int
  valuationAmount      Float?
  reason               String   @default("INVENTORY") // INVENTORY, MANUAL

  createdById          String   @db.ObjectId
  createdAt            DateTime @default(now())
}

model InventoryCount {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  startedById    String   @db.ObjectId
  startedBy      User     @relation(fields: [startedById], references: [id])
  completedAt    DateTime?
  notes          String?

  lines          InventoryCountLine[]
  createdAt      DateTime @default(now())
}

model InventoryCountLine {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  inventoryCountId String   @db.ObjectId
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  pharmacyItemId   String   @db.ObjectId
  pharmacyItem     PharmacyItem @relation(fields: [pharmacyItemId], references: [id])

  systemQuantity   Int
  countedQuantity  Int?
  unitCost         Float?

  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model FinancialTransaction {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  type           TransactionType
  category       TransactionCategory @default(OTHER)
  amount         Float               // Montant en FCFA
  description    String              // Motif / Libellé de l'opération
  
  patientId      String?             @db.ObjectId
  patient        Patient?            @relation(fields: [patientId], references: [id])
  
  pharmacyItemId String?             @db.ObjectId
  pharmacyItem   PharmacyItem?       @relation(fields: [pharmacyItemId], references: [id])
  quantity       Int?                // Pour les ventes de pharmacie

  recordedById   String              @db.ObjectId
  recordedBy     User                @relation("RecordedTransactions", fields: [recordedById], references: [id])

  organizationId String?             @db.ObjectId
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  createdAt      DateTime            @default(now())
}

// Facture générée automatiquement à la clôture d'une consultation par un CAREGIVER
// (qui n'a pas accès à la caisse) ; un COORDINATOR/PHARMACIST la finalise ensuite
// en FinancialTransaction via recordMultiItemInvoice.
model PendingInvoice {
  id                      String         @id @default(auto()) @map("_id") @db.ObjectId
  status                  String         @default("PENDING") // PENDING, FINALIZED

  patientId               String         @db.ObjectId
  patient                 Patient        @relation(fields: [patientId], references: [id])

  medicalRecordId         String?        @db.ObjectId
  medicalRecord           MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  organizationId          String?        @db.ObjectId
  organization            Organization?  @relation(fields: [organizationId], references: [id])

  items                   Json           // Même forme que le panier de recordMultiItemInvoice

  createdById             String         @db.ObjectId
  createdBy               User           @relation("PendingInvoiceCreatedBy", fields: [createdById], references: [id])

  financialTransactionId  String?        @db.ObjectId

  createdAt               DateTime       @default(now())
  finalizedAt             DateTime?

  prescriptions           Prescription[]
}

// Ordonnance électronique structurée. Rattachée à une consultation (medicalRecordId/
// appointmentId) ou écrite hors consultation (renouvellement). La vérification d'interactions
// (IA, Gemini, à titre indicatif) est calculée après l'écriture et son résultat brut conservé
// pour audit — jamais bloquant pour la création/le renouvellement de l'ordonnance.
model Prescription {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId         String    @db.ObjectId
  patient           Patient   @relation(fields: [patientId], references: [id])

  prescribedById    String    @db.ObjectId
  prescribedBy      User      @relation("PrescriptionPrescribedBy", fields: [prescribedById], references: [id])

  medicalRecordId   String?   @db.ObjectId
  medicalRecord     MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  appointmentId     String?   @db.ObjectId
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])

  organizationId    String?   @db.ObjectId
  organization      Organization? @relation(fields: [organizationId], references: [id])

  // Renouvellement : pointe vers l'ordonnance d'origine.
  renewedFromId     String?   @db.ObjectId
  renewedFrom       Prescription?  @relation("PrescriptionRenewal", fields: [renewedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renewals          Prescription[] @relation("PrescriptionRenewal")

  templateId        String?   @db.ObjectId
  template          PrescriptionTemplate? @relation(fields: [templateId], references: [id])

  status            String    @default("ACTIVE") // ACTIVE, SENT_TO_PHARMACY, DISPENSED, SUPERSEDED, CANCELLED
  notes             String?

  // Résultat brut de la vérification IA — jamais bloquant, affiché au médecin dès disponible.
  interactionCheck  Json?     // { severity: "NONE"|"LOW"|"MODERATE"|"HIGH", warnings: [{drugs:[string], description}], checkedAt, error? }

  items             PrescriptionItem[]

  pendingInvoiceId  String?   @db.ObjectId
  pendingInvoice    PendingInvoice? @relation(fields: [pendingInvoiceId], references: [id])
  sentToPharmacyAt  DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PrescriptionItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  prescriptionId  String   @db.ObjectId
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  // Rapprochement optionnel avec le catalogue pharmacie (facturation) — un médicament
  // hors catalogue reste prescriptible en texte libre.
  pharmacyItemId  String?  @db.ObjectId
  pharmacyItem    PharmacyItem? @relation(fields: [pharmacyItemId], references: [id])

  drugName        String
  dosage          String
  frequency       String
  duration        String?  // ex: "7 jours"
  instructions    String?
  quantity        Int?     // Quantité totale à délivrer
}

// Modèle réutilisable — par pathologie ou personnel à un médecin (isShared=false).
model PrescriptionTemplate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  pathology       String?  // Libellé libre ou code CIM-10
  createdById     String   @db.ObjectId
  createdBy       User     @relation("PrescriptionTemplateCreatedBy", fields: [createdById], references: [id])
  organizationId  String?  @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])
  isShared        Boolean  @default(false) // true = visible par tous les MEDECIN de la clinique

  items           Json     // [{ drugName, dosage, frequency, duration, instructions }]
  prescriptions   Prescription[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Supplier {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  isActive        Boolean  @default(true)

  organizationId  String?  @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])

  purchaseOrders  PurchaseOrder[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PurchaseOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierId      String   @db.ObjectId
  supplier        Supplier @relation(fields: [supplierId], references: [id])

  status          String   @default("DRAFT") // DRAFT, SENT, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  reference       String?
  expectedDate    DateTime?
  notes           String?

  organizationId  String   @db.ObjectId
  organization    Organization @relation(fields: [organizationId], references: [id])

  createdById     String   @db.ObjectId
  createdBy       User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  lines           PurchaseOrderLine[]

  sentAt          DateTime?
  receivedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PurchaseOrderLine {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId   String   @db.ObjectId
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  pharmacyItemId    String?  @db.ObjectId
  pharmacyItem      PharmacyItem? @relation(fields: [pharmacyItemId], references: [id])
  newItemName       String?  // Produit pas encore au catalogue, créé à la réception

  quantityOrdered   Int
  quantityReceived  Int      @default(0)
  unitCost          Float

  batchNumber       String?
  expiryDate        DateTime?
}
