generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  MEDECIN
  CAREGIVER
  PHARMACIST
  CASHIER
  FAMILY
  PATIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OrgType {
  HOLDING
  CLINIC
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  TRIALING
}

enum PaymentFrequency {
  MONTHLY
  YEARLY
}

// Mode de règlement de la holding — FULL : le montant est réglé en une seule fois. INSTALLMENTS :
// réglé en plusieurs tranches (paymentAmount représente alors le montant d'UNE tranche, comme
// paymentAmount représente déjà un montant "par période" avec paymentFrequency). Purement
// déclaratif/manuel comme le reste du suivi d'abonnement de ce projet (licenseExpiresAt,
// paymentAmount...) — aucune passerelle de paiement intégrée, le super admin renseigne et met à
// jour ces champs lui-même.
enum PaymentPlan {
  FULL
  INSTALLMENTS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  PHARMACY_SALE
  SERVICE_FEE
  OPERATIONAL_EXPENSE
  PHARMACY_PURCHASE
  STOCK_ADJUSTMENT
  OTHER
}

enum PharmacyCategory {
  MEDICATION
  CONSUMABLE
  EQUIPMENT
}

model Organization {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  type     OrgType
  // Logo affiché sur tous les documents PDF générés pour cette clinique (reçus, ordonnances,
  // rapports labo, dossiers patient...). Stocké en data URI (base64) directement plutôt que via
  // un service de stockage externe : évite toute dépendance réseau/CDN pendant la génération du
  // PDF (@react-pdf/renderer accepte un data URI nativement) et reste minuscule pour un simple
  // logo redimensionné côté client avant l'envoi (cf. src/app/dashboard/clinics/[id]/settings).
  logoUrl  String?
  parentId String?        @db.ObjectId
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Organization[] @relation("OrgHierarchy")

  users                 User[]
  patients              Patient[]
  wards                 Ward[]
  rooms                 Room[]
  beds                  Bed[]
  pharmacyItems         PharmacyItem[]
  financialTransactions FinancialTransaction[]
  stockPurchases        StockPurchase[]
  inventoryCounts       InventoryCount[]
  pendingInvoices       PendingInvoice[]
  labOrders             LabOrder[]
  labTests              LabTest[]
  prescriptions         Prescription[]
  prescriptionTemplates PrescriptionTemplate[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  cashRegisters         CashRegister[]
  cashSessions          CashSession[]

  plan               SubscriptionPlan   @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  licenseExpiresAt   DateTime?
  stripeCustomerId   String?
  maxClinics         Int                @default(1)
  maxUsers           Int                @default(10)
  isActive           Boolean            @default(true) // Permet à un ADMIN (holding) de suspendre une clinique

  paymentAmount    Float? // Tarif actuel (FCFA), éditable à tout moment
  paymentFrequency PaymentFrequency?

  // Mode de règlement — cf. enum PaymentPlan. installmentsCount n'a de sens qu'en INSTALLMENTS
  // (nombre de tranches prévues, ex: 3, 6, 12) ; nextPaymentDate est la date de la prochaine
  // échéance à régler (tranche suivante, ou date d'échéance du paiement intégral s'il n'a pas
  // encore été réglé) — affichée sur la facture téléchargeable (holding-invoice-pdf.tsx).
  paymentPlan      PaymentPlan @default(FULL)
  installmentsCount Int?
  nextPaymentDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model User {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  email                  String   @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   Role
  phone                  String?
  avatarUrl              String?
  isActive               Boolean  @default(true)
  requiresPasswordChange Boolean  @default(false)
  // Types de Notification (ex: "INCIDENT", "APPOINTMENT") que l'utilisateur a
  // désactivés depuis Paramètres > Notifications. Vide = tout est affiché.
  mutedNotificationTypes String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  patientProfile     Patient?            @relation("UserPatient")
  familyProfile      FamilyMember?       @relation("UserFamily")
  caregiverProfile   Caregiver?          @relation("UserCaregiver")
  coordinatorProfile MedicalCoordinator? @relation("UserCoordinator")

  auditLogs                    AuditLog[]
  messagesSent                 Message[]                 @relation("Sender")
  conversations                ConversationParticipant[]
  notifications                Notification[]
  aiConversations              AIConversation[]
  vitalsRecorded               VitalSign[]               @relation("RecordedVitals")
  financialTransactions        FinancialTransaction[]    @relation("RecordedTransactions")
  passwordResetTokens          PasswordResetToken[]
  stockPurchasesRecorded       StockPurchase[]
  inventoryCountsStarted       InventoryCount[]
  pendingInvoicesCreated       PendingInvoice[]          @relation("PendingInvoiceCreatedBy")
  labOrdersOrdered             LabOrder[]                @relation("LabOrderOrderedBy")
  labOrdersSampleCollected     LabOrder[]                @relation("LabOrderSampleCollectedBy")
  labResultsRecorded           LabResult[]               @relation("LabResultRecordedBy")
  labResultsValidated          LabResult[]               @relation("LabResultValidatedBy")
  medicalRecordsCreated        MedicalRecord[]           @relation("MedicalRecordCreatedBy")
  prescriptionsWritten         Prescription[]            @relation("PrescriptionPrescribedBy")
  prescriptionTemplatesCreated PrescriptionTemplate[]    @relation("PrescriptionTemplateCreatedBy")
  purchaseOrdersCreated        PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  consultationDraftsCreated    ConsultationDraft[]       @relation("ConsultationDraftCreatedBy")
  pregnanciesCreated           Pregnancy[]               @relation("PregnancyCreatedBy")
  prenatalVisitsRecorded       PrenatalVisit[]           @relation("PrenatalVisitRecordedBy")
  deliveriesRecorded           Delivery[]                @relation("DeliveryRecordedBy")
  cashSessionsOpened           CashSession[]             @relation("CashSessionOpenedBy")
  cashSessionsClosed           CashSession[]             @relation("CashSessionClosedBy")
  prescriptionsDispensed       Prescription[]            @relation("PrescriptionDispensedBy")

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, role])
}

model Patient {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation("UserPatient", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dateOfBirth      DateTime
  address          String
  emergencyContact String?
  dependencyLevel  Int      @default(1)
  bloodType        String? // ex: "O+", "AB-"
  sex              String? // ex: "M", "F", "Autre"

  status String @default("ADMITTED") // ADMITTED, DISCHARGED, ARCHIVED

  pathologies String[]
  allergies   String[]

  familyMembers         FamilyMember[]
  carePlans             CarePlan[]
  appointments          Appointment[]
  incidents             Incident[]
  medicalRecords        MedicalRecord[]
  aiAnalyses            AIAnalysis[]
  contracts             Contract[]
  aiConversations       AIConversation[]
  vitalSigns            VitalSign[]
  financialTransactions FinancialTransaction[]
  pendingInvoices       PendingInvoice[]
  labOrders             LabOrder[]
  prescriptions         Prescription[]

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Pas de @unique ici : un index unique non-sparse sur MongoDB entre en conflit avec les
  // nombreux patients existants sans lit (bedId absent = traité comme null par Mongo pour
  // l'unicité, sauf index sparse — non exposé par le DSL Prisma pour ce connecteur). L'unicité
  // « un lit = au plus un patient » est donc garantie procéduralement par transaction
  // (cf. assignPatientToBed dans src/actions/wards.ts), pas au niveau du schéma.
  bedId String? @db.ObjectId
  bed   Bed?    @relation("PatientBed", fields: [bedId], references: [id])

  consultationDrafts ConsultationDraft[]
  pregnancies        Pregnancy[]

  @@index([organizationId])
  @@index([organizationId, updatedAt])
}

model FamilyMember {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation("UserFamily", fields: [userId], references: [id])

  patientId    String  @db.ObjectId
  patient      Patient @relation(fields: [patientId], references: [id])
  relationship String

  @@index([patientId])
}

model Caregiver {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation("UserCaregiver", fields: [userId], references: [id])

  specialties    String[]
  certifications String[]
  isAvailable    Boolean  @default(true)
  licenseNumber  String? // N° RPPS/Ordre — renseigné pour un MEDECIN, null pour un infirmier(e)

  tasks        CareTask[]
  appointments Appointment[]
  contracts    Contract[]
}

model MedicalCoordinator {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation("UserCoordinator", fields: [userId], references: [id])

  managedPlans CarePlan[]
}

model MedicalRecord {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  title          String
  description    String
  documentUrl    String?
  diagnosisCode  String? // Code ICD-10 (liste curatée, cf. src/lib/icd10-codes.ts)
  diagnosisLabel String?
  createdById    String?  @db.ObjectId // Optionnel : pas de backfill des dossiers historiques
  createdBy      User?    @relation("MedicalRecordCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  pendingInvoices PendingInvoice[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]

  @@index([patientId])
  @@index([appointmentId])
}

model CarePlan {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String             @db.ObjectId
  patient       Patient            @relation(fields: [patientId], references: [id])
  coordinatorId String             @db.ObjectId
  coordinator   MedicalCoordinator @relation(fields: [coordinatorId], references: [id])

  title            String
  startDate        DateTime
  endDate          DateTime?
  status           String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  dischargeSummary String?
  completedAt      DateTime?
  closedById       String?   @db.ObjectId

  tasks       CareTask[]
  medications Medication[]

  @@index([patientId])
  @@index([coordinatorId])
}

model CareTask {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId  String     @db.ObjectId
  carePlan    CarePlan   @relation(fields: [carePlanId], references: [id])
  caregiverId String?    @db.ObjectId
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id])

  title        String
  description  String?
  scheduledFor DateTime
  status       String    @default("PENDING")
  completedAt  DateTime?

  @@index([carePlanId])
  @@index([caregiverId])
}

model Medication {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId String   @db.ObjectId
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id])

  name         String
  dosage       String
  frequency    String
  instructions String?

  @@index([carePlanId])
}

model Appointment {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String     @db.ObjectId
  patient     Patient    @relation(fields: [patientId], references: [id])
  caregiverId String?    @db.ObjectId
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id])

  title           String
  scheduledAt     DateTime
  durationMinutes Int
  type            String
  status          String   @default("SCHEDULED")

  prescriptions      Prescription[]
  labOrders          LabOrder[]
  consultationDrafts ConsultationDraft[]
  medicalRecords     MedicalRecord[]
  vitalSigns         VitalSign[]

  @@index([patientId, scheduledAt])
  @@index([caregiverId, scheduledAt])
}

// Brouillon de consultation en cours — permet d'enregistrer symptômes/diagnostic/plan/
// médicaments sans clôturer (donc sans créer le MedicalRecord/l'ordonnance/la facture
// définitifs). Un seul brouillon actif par consultation : identifié par appointmentId
// quand la consultation vient d'un rendez-vous planifié, sinon par (patientId + auteur)
// pour le flux ad-hoc où aucun Appointment n'existe. Supprimé dès que la consultation
// est clôturée avec succès (cf. completeConsultation).
model ConsultationDraft {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String       @db.ObjectId
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdById   String       @db.ObjectId
  createdBy     User         @relation("ConsultationDraftCreatedBy", fields: [createdById], references: [id])

  symptoms       String?
  diagnosis      String?
  plan           String?
  diagnosisCode  String?
  diagnosisLabel String?
  medications    Json? // [{ name, dosage, frequency, instructions }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([patientId, createdById])
}

// Demande d'analyse de laboratoire — pas de catalogue structuré (les analyses demandées
// sont une liste de libellés en texte libre), pour éviter d'avoir à gérer un référentiel
// de tests en plus de ce périmètre.
model LabOrder {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  medicalRecordId String?        @db.ObjectId
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  tests    String[] // Libellés des analyses demandées (ex: "NFS", "Glycémie à jeun") — catalogué ou libre
  notes    String? // Indications cliniques / contexte transmis au laboratoire
  // Cycle de vie complet : PRESCRIBED, SAMPLE_COLLECTED, RECEIVED_AT_LAB, IN_ANALYSIS,
  // TO_VALIDATE, VALIDATED, DELIVERED, CANCELLED (cf. src/actions/lab.ts pour les transitions).
  status   String   @default("PRESCRIBED")
  priority String   @default("ROUTINE") // ROUTINE, URGENT

  // Statut de règlement, orthogonal au statut de workflow labo ci-dessus : NOT_REQUIRED
  // (aucun examen de la demande n'exige la caisse d'abord), PENDING (bloque collectSample),
  // PAID (facture liée finalisée — cf. finalizePendingInvoice dans src/actions/finance.ts).
  paymentStatus    String          @default("NOT_REQUIRED")
  pendingInvoiceId String?         @db.ObjectId
  pendingInvoice   PendingInvoice? @relation("LabOrderInvoice", fields: [pendingInvoiceId], references: [id])

  orderedById String @db.ObjectId
  orderedBy   User   @relation("LabOrderOrderedBy", fields: [orderedById], references: [id])

  // Prélèvement
  sampleType          String? // BLOOD, URINE, STOOL, SALIVA, BIOPSY, CSF, OTHER
  sampleCollectedAt   DateTime?
  sampleCollectedById String?   @db.ObjectId
  sampleCollectedBy   User?     @relation("LabOrderSampleCollectedBy", fields: [sampleCollectedById], references: [id])
  sampleQuantity      String?
  sampleCondition     String?

  results LabResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
  @@index([appointmentId])
  @@index([medicalRecordId])
  @@index([orderedById])
  @@index([pendingInvoiceId])
}

model LabResult {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  labOrderId String   @db.ObjectId
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id])

  testName       String
  value          String
  unit           String?
  referenceRange String?
  isAbnormal     Boolean @default(false)
  notes          String?

  recordedById String @db.ObjectId
  recordedBy   User   @relation("LabResultRecordedBy", fields: [recordedById], references: [id])

  // Validation biologique (maker-checker) : une fois posé, le résultat est verrouillé —
  // src/actions/lab.ts refuse toute modification directe, pas seulement l'UI.
  validatedById String?   @db.ObjectId
  validatedBy   User?     @relation("LabResultValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([labOrderId])
}

// Catalogue d'examens définis par le COORDINATOR (prix, durée, service). Les LabOrder.tests
// restent en texte libre — une correspondance par nom avec un LabTest actif permet de
// facturer automatiquement et de détecter les valeurs critiques (cf. Phases B et E).
model LabTest {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  department      String? // ex: "Hématologie", "Biochimie"
  durationMinutes Int?
  criticalLow     Float? // Seuil bas critique (examens à résultat numérique uniquement)
  criticalHigh    Float? // Seuil haut critique
  consumables     Json? // Recette de consommables annexes : [{ pharmacyItemId, name, quantity }]

  // Le prix n'est plus saisi manuellement : il vient de pharmacyItem.unitPrice. Le produit
  // représente l'examen lui-même (kit, réactif, bandelette...) et est décompté du stock à
  // chaque prélèvement, comme les consommables mais séparément.
  pharmacyItemId       String?       @db.ObjectId
  pharmacyItem         PharmacyItem? @relation("LabTestProduct", fields: [pharmacyItemId], references: [id])
  // true (défaut) = la demande attend le règlement en caisse avant de partir au labo ;
  // false = part directement au labo (examens urgents/critiques).
  requiresPaymentFirst Boolean       @default(true)

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
}

model Incident {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  patientId    String  @db.ObjectId
  patient      Patient @relation(fields: [patientId], references: [id])
  reportedById String  @db.ObjectId

  title       String
  description String
  priority    Priority       @default(MEDIUM)
  status      IncidentStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([patientId, createdAt])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  sender         User         @relation("Sender", fields: [senderId], references: [id])

  content       String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([conversationId, createdAt])
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId])
}

model AIAnalysis {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  riskScore       Int
  riskFactors     String[]
  summary         String
  recommendations String[]
  createdAt       DateTime @default(now())

  @@index([patientId, createdAt])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Permission {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  roles       Role[]
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Contract {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String     @db.ObjectId
  patient     Patient    @relation(fields: [patientId], references: [id])
  caregiverId String?    @db.ObjectId
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id])

  title        String
  status       String    @default("ACTIVE")
  startDate    DateTime
  endDate      DateTime?
  hourlyRate   Float
  hoursPerWeek Int
  documentUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([patientId])
  @@index([caregiverId])
}

model AIConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  patientId String?  @db.ObjectId
  patient   Patient? @relation(fields: [patientId], references: [id])

  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([userId, createdAt])
  @@index([patientId])
}

model AIMessage {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String         @db.ObjectId
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([conversationId])
}

model Ward {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String // Nom d'affichage: "Urgences", "Soins Intensifs", "Maternité"...
  code           String // Code unique: "EMERGENCY", "ICU", "SURGERY", "MATERNITY"...
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  beds           Bed[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Room {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String // ex: "Chambre 12", "Box 3"
  wardId         String       @db.ObjectId
  ward           Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId // dénormalisé depuis ward.organizationId — scoping direct
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  beds           Bed[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([wardId, name])
  @@index([wardId])
  @@index([organizationId])
}

// Seule source de vérité pour « où est ce patient ». `status` est dénormalisé (redondant avec
// la présence de `patient`) pour permettre un comptage bon marché (lits libres) sans jointure —
// toute écriture le synchronise avec Patient.bedId dans la même transaction (cf. assignPatientToBed).
model Bed {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  label          String // ex: "A", "1", "Lit 2" — unique dans sa chambre
  roomId         String       @db.ObjectId
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  wardId         String       @db.ObjectId // dénormalisé depuis room.wardId
  ward           Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId // dénormalisé depuis room.organizationId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("AVAILABLE") // AVAILABLE, OCCUPIED
  // Tableau (pas une valeur unique) : évite d'exiger un @unique côté Patient.bedId (cf. commentaire
  // sur Patient.bedId). En pratique jamais plus d'un élément — garanti par la transaction de
  // assignPatientToBed, pas par le schéma.
  patients       Patient[]    @relation("PatientBed")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([roomId, label])
  @@index([roomId])
  @@index([wardId])
  @@index([organizationId, status])
}

// Suivi de grossesse — scopé patient (comme CarePlan/VitalSign), pas d'organizationId propre :
// pas de vue clinique transverse dans ce périmètre, tout se lit via la fiche patiente.
model Pregnancy {
