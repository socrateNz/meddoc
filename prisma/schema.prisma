// Une caisse physique d'une clinique (guichet). Opérée par sessions successives —
// cf. CashSession — jamais directement : encaisser exige toujours une session OPEN.
model CashRegister {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  organizationId String        @db.ObjectId
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean       @default(true)
  // Verrou atomique anti-course : posé (true) par openRegisterSession via un updateMany
  // conditionné sur false, remis à false par closeRegisterSession. Si deux personnes cliquent
  // "Ouvrir la caisse" au même instant, un seul updateMany peut réussir — l'autre voit count=0
  // et échoue proprement, sans jamais créer deux CashSession OPEN sur la même caisse (même motif
  // que Bed.status dans wards.ts:assignPatientToBed).
  hasOpenSession Boolean       @default(false)
  sessions       CashSession[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Un service (shift) de caissier sur une caisse donnée : ouverte avec un fond de caisse,
// fermée avec un comptage — l'écart (countedAmount - expectedAmount) n'est jamais persisté,
// il est recalculé à la lecture à partir des FinancialTransaction/PendingInvoice liés
// (cf. getSessionSummary dans src/actions/registers.ts) pour ne jamais devenir périmé.
model CashSession {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  registerId     String       @db.ObjectId
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId // dénormalisé depuis register.organizationId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  openedById   String   @db.ObjectId
  openedBy     User     @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openedAt     DateTime @default(now())
  openingFloat Float    @default(0)

  closedById    String?   @db.ObjectId
  closedBy      User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  closedAt      DateTime?
  countedAmount Float?
  notes         String?

  status String @default("OPEN") // OPEN, CLOSED

  transactions    FinancialTransaction[]
  pendingInvoices PendingInvoice[]

  @@index([registerId, status])
  @@index([organizationId, status])
}

model FinancialTransaction {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  type        TransactionType
  category    TransactionCategory @default(OTHER)
  amount      Float // Montant en FCFA
  description String // Motif / Libellé de l'opération

  // Panier détaillé (même forme que PendingInvoice.items) d'une vente à plusieurs articles —
  // persisté pour que le ticket (invoice-modal.tsx/invoice-pdf.tsx) puisse toujours réafficher
  // les quantités/prix réels de chaque ligne, y compris après rechargement ou réimpression
  // ultérieure. Avant ce champ, le panier n'existait qu'en mémoire juste après la création de la
  // transaction (jamais persisté) : rouvrir le ticket plus tard retombait sur un repli fragile,
  // reconstituant les lignes depuis le texte de `description` par regex — lequel répartissait le
  // montant total à parts égales entre les lignes (des prix/quantités inventés, pas les vrais) et
  // pouvait même scinder une ligne en deux si sa description contenait elle-même une virgule (ex:
  // "400mg, Comprimé"). Optionnel : les transactions antérieures à ce champ gardent cet ancien
  // repli, seule option pour elles.
  items Json?

  patientId String?  @db.ObjectId
  patient   Patient? @relation(fields: [patientId], references: [id])
  customPatientName String? // Nom du client/patient saisi manuellement à la caisse si non inscrit
  customPatientPhone String? // Numéro de téléphone du client/patient saisi manuellement

  pharmacyItemId String?       @db.ObjectId
  pharmacyItem   PharmacyItem? @relation(fields: [pharmacyItemId], references: [id])
  quantity       Int? // Pour les ventes de pharmacie

  recordedById String @db.ObjectId
  recordedBy   User   @relation("RecordedTransactions", fields: [recordedById], references: [id])

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Rattachement à la session de caisse qui l'a encaissée — présent uniquement pour les
  // encaissements/dépenses passés par la caisse (payPendingInvoice, createCaisseSale,
  // recordExpense) ; absent pour les mouvements hors-session (achats/ajustements de stock).
  cashSessionId String?      @db.ObjectId
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  // Rattachement au ticket réglé — many-to-one : une facture payée en plusieurs fois (paiement
  // échelonné) a autant de FinancialTransaction que de règlements, chacun avec son propre
  // cashSessionId (la session réellement ouverte au moment de CE règlement précis). Remplace
  // l'ancien lien 1:1 procédural (PendingInvoice.financialTransactionId).
  pendingInvoiceId String?         @db.ObjectId
  pendingInvoice   PendingInvoice? @relation(fields: [pendingInvoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([patientId])
  @@index([pharmacyItemId])
  @@index([cashSessionId])
  @@index([pendingInvoiceId])
}

// Facture émise à la caisse : PENDING (rien reçu) -> PARTIAL (acompte reçu, cf. payments) ->
// PAID (solde à zéro) — générée automatiquement à la clôture d'une consultation par un
// CAREGIVER, une demande labo, un envoi d'ordonnance à la pharmacie, ou directement à la
// caisse (createCaisseSale). La remise des articles au comptoir pharmacie est désormais
// indépendante de ce statut de paiement (cf. dispensedAt) : un PHARMACIST peut remettre les
// médicaments avant règlement complet (vente à crédit / paiement échelonné).
model PendingInvoice {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  status String @default("PENDING") // PENDING, PARTIAL, PAID

  // Optionnel : une vente comptant à la caisse ("Client comptant", sans patient sélectionné)
  // doit quand même passer par un PendingInvoice dès qu'elle contient un article PHARMACY —
  // sinon rien n'apparaît dans la file d'attente pharmacie et le stock n'est jamais décrémenté
  // (cf. createCaisseSale). Les créations liées à un patient réel (ordonnance, labo,
  // consultation) continuent de toujours renseigner patientId.
  patientId String?  @db.ObjectId
  patient   Patient? @relation(fields: [patientId], references: [id])
  customPatientName String? // Nom du client/patient saisi manuellement à la caisse si non inscrit
  customPatientPhone String? // Numéro de téléphone du client/patient saisi manuellement

  medicalRecordId String?        @db.ObjectId
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  items Json // Même forme que le panier de recordMultiItemInvoice

  createdById String @db.ObjectId
  createdBy   User   @relation("PendingInvoiceCreatedBy", fields: [createdById], references: [id])

  // Dernière session ayant enregistré un paiement sur cette facture — informatif seulement.
  // Chaque paiement individuel porte son propre FinancialTransaction.cashSessionId (posé à la
  // session réellement ouverte au moment de CE règlement) ; c'est lui, jamais celui-ci, qui sert
  // de source de vérité pour la réconciliation par session (getSessionSummary,
  // closeRegisterSession) — une facture réglée en plusieurs fois sur plusieurs sessions n'a ici
  // que la dernière.
  cashSessionId String?      @db.ObjectId
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  // Tous les règlements successifs (échelonnés ou non) de cette facture — remplace l'ancien
  // financialTransactionId 1:1. Montant réellement encaissé à date = somme de payments.amount ;
  // reste à payer = somme(items.amount) − cette somme.
  payments FinancialTransaction[]

  createdAt   DateTime  @default(now())
  paidAt      DateTime? // posé uniquement au moment où le solde atteint zéro (status -> PAID)
  dispensedAt DateTime? // seul marqueur de remise pharmacie désormais (avant : status="DISPENSED")
  finalizedAt DateTime? // Historique (pré-caisse) — non écrit par le nouveau flux, cf. paidAt

  prescriptions Prescription[]
  labOrders     LabOrder[]     @relation("LabOrderInvoice")

  @@index([organizationId, status])
  @@index([patientId])
  @@index([medicalRecordId])
  @@index([cashSessionId])
}

// Ordonnance électronique structurée. Rattachée à une consultation (medicalRecordId/
// appointmentId) ou écrite hors consultation (renouvellement). La vérification d'interactions
// (IA, Gemini, à titre indicatif) est calculée après l'écriture et son résultat brut conservé
// pour audit — jamais bloquant pour la création/le renouvellement de l'ordonnance.
model Prescription {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  prescribedById String @db.ObjectId
  prescribedBy   User   @relation("PrescriptionPrescribedBy", fields: [prescribedById], references: [id])

  medicalRecordId String?        @db.ObjectId
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Renouvellement : pointe vers l'ordonnance d'origine.
  renewedFromId String?        @db.ObjectId
  renewedFrom   Prescription?  @relation("PrescriptionRenewal", fields: [renewedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renewals      Prescription[] @relation("PrescriptionRenewal")

  templateId String?               @db.ObjectId
  template   PrescriptionTemplate? @relation(fields: [templateId], references: [id])

  status String  @default("ACTIVE") // ACTIVE, SENT_TO_PHARMACY, DISPENSED, SUPERSEDED, CANCELLED
  notes  String?

  // Résultat brut de la vérification IA — jamais bloquant, affiché au médecin dès disponible.
  interactionCheck Json? // { severity: "NONE"|"LOW"|"MODERATE"|"HIGH", warnings: [{drugs:[string], description}], checkedAt, error? }

  items PrescriptionItem[]

  pendingInvoiceId String?         @db.ObjectId
  pendingInvoice   PendingInvoice? @relation(fields: [pendingInvoiceId], references: [id])
  sentToPharmacyAt DateTime?

  // Posés par dispensePendingInvoice (PHARMACIST uniquement) quand status passe à DISPENSED —
  // même convention de nommage que LabOrder.sampleCollectedById/sampleCollectedAt.
  dispensedById String?   @db.ObjectId
  dispensedBy   User?     @relation("PrescriptionDispensedBy", fields: [dispensedById], references: [id])
  dispensedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([organizationId, status])
  @@index([appointmentId])
  @@index([medicalRecordId])
  @@index([pendingInvoiceId])
}

model PrescriptionItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  prescriptionId String       @db.ObjectId
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  // Rapprochement optionnel avec le catalogue pharmacie (facturation) — un médicament
  // hors catalogue reste prescriptible en texte libre.
  pharmacyItemId String?       @db.ObjectId
  pharmacyItem   PharmacyItem? @relation(fields: [pharmacyItemId], references: [id])

  drugName     String
  dosage       String
  frequency    String
  duration     String? // ex: "7 jours"
  instructions String?
  quantity     Int? // Quantité totale à délivrer

  @@index([prescriptionId])
}

// Modèle réutilisable — par pathologie ou personnel à un médecin (isShared=false).
model PrescriptionTemplate {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  pathology      String? // Libellé libre ou code CIM-10
  createdById    String        @db.ObjectId
  createdBy      User          @relation("PrescriptionTemplateCreatedBy", fields: [createdById], references: [id])
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isShared       Boolean       @default(false) // true = visible par tous les MEDECIN de la clinique

  items         Json // [{ drugName, dosage, frequency, duration, instructions }]
  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
}

model Supplier {
