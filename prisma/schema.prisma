  expectedDueDate     DateTime // DPA — date prévue d'accouchement, éditable (redatage échographique)
  gravidity           Int // G — nombre total de grossesses
  parity              Int // P — nombre d'accouchements antérieurs
  riskFactors         String[] @default([])
  status              String   @default("ACTIVE") // ACTIVE, DELIVERED, MISCARRIED, TERMINATED

  createdById String @db.ObjectId
  createdBy   User   @relation("PregnancyCreatedBy", fields: [createdById], references: [id])

  prenatalVisits PrenatalVisit[]
  delivery       Delivery?

