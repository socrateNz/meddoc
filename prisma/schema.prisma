generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  CAREGIVER
  FAMILY
  PATIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OrgType {
  HOLDING
  CLINIC
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  TRIALING
}

enum PaymentFrequency {
  MONTHLY
  YEARLY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  PHARMACY_SALE
  SERVICE_FEE
  OPERATIONAL_EXPENSE
  PHARMACY_PURCHASE
  STOCK_ADJUSTMENT
  OTHER
}

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      OrgType
  parentId  String?  @db.ObjectId
  parent    Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Organization[] @relation("OrgHierarchy")
  
  users     User[]
  patients  Patient[]
  wards     Ward[]
  pharmacyItems PharmacyItem[]
  financialTransactions FinancialTransaction[]
  stockPurchases StockPurchase[]
  inventoryCounts InventoryCount[]

  plan                SubscriptionPlan @default(TRIAL)
  subscriptionStatus  SubscriptionStatus @default(TRIALING)
  licenseExpiresAt    DateTime?
  stripeCustomerId    String?
  maxClinics          Int @default(1)
  maxUsers            Int @default(10)

  paymentAmount       Float?              // Tarif actuel (FCFA), éditable à tout moment
  paymentFrequency    PaymentFrequency?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  phone         String?
  avatarUrl     String?
  isActive               Boolean   @default(true)
  requiresPasswordChange Boolean   @default(false)
  // Types de Notification (ex: "INCIDENT", "APPOINTMENT") que l'utilisateur a
  // désactivés depuis Paramètres > Notifications. Vide = tout est affiché.
  mutedNotificationTypes String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patientProfile      Patient?            @relation("UserPatient")
  familyProfile       FamilyMember?       @relation("UserFamily")
  caregiverProfile    Caregiver?          @relation("UserCaregiver")
  coordinatorProfile  MedicalCoordinator? @relation("UserCoordinator")

  auditLogs           AuditLog[]
  messagesSent        Message[]           @relation("Sender")
  conversations       ConversationParticipant[]
  notifications       Notification[]
  aiConversations     AIConversation[]
  vitalsRecorded      VitalSign[]         @relation("RecordedVitals")
  financialTransactions FinancialTransaction[] @relation("RecordedTransactions")
  passwordResetTokens PasswordResetToken[]
  stockPurchasesRecorded StockPurchase[]
  inventoryCountsStarted InventoryCount[]

  organizationId      String?   @db.ObjectId
  organization        Organization? @relation(fields: [organizationId], references: [id])
}

model Patient {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserPatient", fields: [userId], references: [id])
  
  dateOfBirth     DateTime
  address         String
  emergencyContact String?
  dependencyLevel Int      @default(1)

  status          String   @default("ADMITTED") // ADMITTED, DISCHARGED, ARCHIVED

  pathologies     String[]
  allergies       String[]

  familyMembers   FamilyMember[]
  carePlans       CarePlan[]
  appointments    Appointment[]
  incidents       Incident[]
  medicalRecords  MedicalRecord[]
  aiAnalyses      AIAnalysis[]
  contracts       Contract[]
  aiConversations AIConversation[]
  vitalSigns      VitalSign[]
  financialTransactions FinancialTransaction[]

  organizationId  String?   @db.ObjectId
  organization    Organization? @relation(fields: [organizationId], references: [id])

  wardId          String?   @db.ObjectId
  ward            Ward?     @relation("PatientWard", fields: [wardId], references: [id])
}

model FamilyMember {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserFamily", fields: [userId], references: [id])
  
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  relationship    String
}

model Caregiver {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserCaregiver", fields: [userId], references: [id])
  
  specialties     String[]
  certifications  String[]
  isAvailable     Boolean  @default(true)

  tasks           CareTask[]
  appointments    Appointment[]
  contracts       Contract[]
}

model MedicalCoordinator {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserCoordinator", fields: [userId], references: [id])
  
  managedPlans    CarePlan[]
}

model MedicalRecord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  
  title           String
  description     String
  documentUrl     String?
  createdAt       DateTime @default(now())
}

model CarePlan {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String   @db.ObjectId
  patient          Patient  @relation(fields: [patientId], references: [id])
  coordinatorId    String   @db.ObjectId
  coordinator      MedicalCoordinator @relation(fields: [coordinatorId], references: [id])
  
  title            String
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  dischargeSummary String?
  completedAt      DateTime?
  closedById       String?  @db.ObjectId
  
  tasks            CareTask[]
  medications      Medication[]
}

model CareTask {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId      String   @db.ObjectId
  carePlan        CarePlan @relation(fields: [carePlanId], references: [id])
  caregiverId     String?  @db.ObjectId
  caregiver       Caregiver? @relation(fields: [caregiverId], references: [id])
  
  title           String
  description     String?
  scheduledFor    DateTime
  status          String   @default("PENDING")
  completedAt     DateTime?
}

model Medication {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  carePlanId      String   @db.ObjectId
  carePlan        CarePlan @relation(fields: [carePlanId], references: [id])
  
  name            String
  dosage          String
  frequency       String
  instructions    String?
}

model Appointment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  caregiverId     String?  @db.ObjectId
  caregiver       Caregiver? @relation(fields: [caregiverId], references: [id])
  
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  type            String
  status          String   @default("SCHEDULED")
}

model Incident {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  reportedById    String   @db.ObjectId
  
  title           String
  description     String
  priority        Priority @default(MEDIUM)
  status          IncidentStatus @default(OPEN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Message {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @db.ObjectId
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderId        String   @db.ObjectId
  sender          User     @relation("Sender", fields: [senderId], references: [id])
  
  content         String
  attachmentUrl   String?
  createdAt       DateTime @default(now())
}

model Conversation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  createdAt       DateTime @default(now())
  
  participants    ConversationParticipant[]
  messages        Message[]
}

model ConversationParticipant {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String   @db.ObjectId
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
}

model AIAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  patient         Patient  @relation(fields: [patientId], references: [id])
  
  riskScore       Int
  riskFactors     String[]
  summary         String
  recommendations String[]
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  action          String
  entityType      String
  entityId        String
  details         String?
  createdAt       DateTime @default(now())
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  roles       Role[]
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO")
  createdAt   DateTime @default(now())
}

model Contract {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String   @db.ObjectId
  patient     Patient  @relation(fields: [patientId], references: [id])
  caregiverId String?  @db.ObjectId
  caregiver   Caregiver? @relation(fields: [caregiverId], references: [id])
  
  title       String
  status      String   @default("ACTIVE")
  startDate   DateTime
  endDate     DateTime?
  hourlyRate  Float
  hoursPerWeek Int
  documentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIConversation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  patientId   String?  @db.ObjectId
  patient     Patient? @relation(fields: [patientId], references: [id])
  
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    AIMessage[]
}

model AIMessage {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           String
  content        String
  createdAt      DateTime @default(now())
}

model Ward {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String       // Nom d'affichage: "Urgences", "Soins Intensifs", etc.
  code           String       // Code unique: "EMERGENCY", "ICU", "SURGERY"
  capacity       Int          // Capacité maximale en lits
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients       Patient[]    @relation("PatientWard")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model VitalSign {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String   @db.ObjectId
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedById     String   @db.ObjectId
  recordedBy       User     @relation("RecordedVitals", fields: [recordedById], references: [id])
  
  temperature      Float?   // Degrés Celsius (ex: 37.5)
  bloodPressure    String?  // Systolique/Diastolique (ex: "120/80")
  heartRate        Int?     // BPM (ex: 72)
  oxygenSaturation Int?     // SpO2 % (ex: 98)
  bloodSugar       Float?   // g/L (ex: 1.05)
  weight           Float?   // kg (ex: 70.5)
  painScore        Int?     // Échelle 0-10
  notes            String?
  createdAt        DateTime @default(now())
}

model PharmacyItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  dosage         String?  // ex: "500mg, Comprimé"
  category       String   @default("MEDICATION")
  stockQuantity  Int      @default(0)
  reorderLevel   Int      @default(10)
  unitPrice      Float    // Prix unitaire en FCFA
  batchNumber    String?  // Numéro de lot
  expiryDate     DateTime? // Date de péremption
  supplier       String?  // Fournisseur
  location       String?  // Rayon / Emplacement
  organizationId String?  @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id])

  transactions   FinancialTransaction[]
  stockPurchases StockPurchase[]
  stockAdjustments StockAdjustment[]
  inventoryLines InventoryCountLine[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Un lot d'achat pour un produit de pharmacie. Chaque achat garde son propre
// prix (traçabilité par lot) : remainingQuantity est décrémenté en FEFO par
// les ventes et les ajustements d'inventaire, ce qui permet de valoriser le
// stock restant aux prix réellement payés plutôt qu'à un prix moyen unique.
model StockPurchase {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyItemId    String   @db.ObjectId
  pharmacyItem      PharmacyItem @relation(fields: [pharmacyItemId], references: [id])

  quantity          Int
  remainingQuantity Int
  purchasePrice     Float    // Prix d'achat unitaire de ce lot précis (FCFA)
  totalCost         Float

  supplier          String?
  batchNumber       String?
  expiryDate        DateTime?
  invoiceRef        String?

  purchasedById     String   @db.ObjectId
  purchasedBy       User     @relation(fields: [purchasedById], references: [id])
  organizationId    String?  @db.ObjectId
  organization      Organization? @relation(fields: [organizationId], references: [id])

  createdAt         DateTime @default(now())
}

// Correction de stock issue d'un inventaire (ou d'un ajustement manuel).
// quantityDelta négatif = perte, positif = surplus retrouvé.
model StockAdjustment {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyItemId       String   @db.ObjectId
  pharmacyItem         PharmacyItem @relation(fields: [pharmacyItemId], references: [id])
  inventoryCountLineId String?  @db.ObjectId

  quantityDelta        Int
  valuationAmount      Float?
  reason               String   @default("INVENTORY") // INVENTORY, MANUAL

  createdById          String   @db.ObjectId
  createdAt            DateTime @default(now())
}

model InventoryCount {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  startedById    String   @db.ObjectId
  startedBy      User     @relation(fields: [startedById], references: [id])
  completedAt    DateTime?
  notes          String?

  lines          InventoryCountLine[]
  createdAt      DateTime @default(now())
}

model InventoryCountLine {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  inventoryCountId String   @db.ObjectId
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  pharmacyItemId   String   @db.ObjectId
  pharmacyItem     PharmacyItem @relation(fields: [pharmacyItemId], references: [id])

  systemQuantity   Int
  countedQuantity  Int?
  unitCost         Float?

  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model FinancialTransaction {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  type           TransactionType
  category       TransactionCategory @default(OTHER)
  amount         Float               // Montant en FCFA
  description    String              // Motif / Libellé de l'opération
  
  patientId      String?             @db.ObjectId
  patient        Patient?            @relation(fields: [patientId], references: [id])
  
  pharmacyItemId String?             @db.ObjectId
  pharmacyItem   PharmacyItem?       @relation(fields: [pharmacyItemId], references: [id])
  quantity       Int?                // Pour les ventes de pharmacie

  recordedById   String              @db.ObjectId
  recordedBy     User                @relation("RecordedTransactions", fields: [recordedById], references: [id])

  organizationId String?             @db.ObjectId
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  createdAt      DateTime            @default(now())
}
